.tiny-star{font-size:18px;line-height:0;vertical-align:middle;margin-right:8px}
.story-feature h3{font-family:var(--serif);font-weight:500;font-size:49px;line-height:.95;letter-spacing:-.035em;margin:19px 0}
.story-feature p{font-size:13px;line-height:1.85;color:#bac7bd;max-width:400px;margin-bottom:24px}
.story-source{display:flex;align-items:center;gap:9px;font-size:11px;color:#b7c3b7;margin-top:60px}
.story-source svg{color:var(--gold)}
.story-source a{color:#e0c592;text-decoration:underline;text-underline-offset:3px}
.story-art{position:relative;padding:5px 23px 42px 5px}
.story-image-frame{position:relative;width:100%;height:610px;overflow:hidden;border-radius:260px 260px 2px 2px;border:10px solid rgba(237,232,213,.17);background:#655741}
.story-image-frame img{object-fit:cover;object-position:center}
.story-image-note{position:absolute;bottom:69px;left:-22px;background:#e9e4d7;color:var(--ink);width:235px;min-height:155px;padding:23px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:12px 16px 35px rgba(0,0,0,.18)}
.story-image-note>span:first-child{font-size:9px;letter-spacing:.18em;font-weight:700;color:var(--rust)}
.story-image-note strong{font-family:var(--serif);font-size:30px;font-weight:600;line-height:.9}
.story-note-symbol{position:absolute;right:20px;bottom:13px;font-size:22px;color:var(--rust)}
.story-art-index{position:absolute;right:23px;bottom:18px;font-size:9px;letter-spacing:.18em;color:#bfcbbe}
.story-timeline{margin-top:64px;border-top:1px solid rgba(238,233,218,.18);display:flex;align-items:start;justify-content:space-between;padding-top:20px;gap:25px}
.story-timeline>div:not(.timeline-track){display:flex;flex-direction:column;gap:6px}
.story-timeline>div:last-child{text-align:right}
.story-timeline span:not(.timeline-track span){font-family:var(--serif);font-size:39px;line-height:1;color:#d6b881}
.story-timeline small{font-size:9px;letter-spacing:.19em;color:#b6c2b7}
.timeline-track{height:1px;background:rgba(230,227,211,.38);margin-top:21px;flex:1;display:flex;justify-content:space-around}
.timeline-track span{width:7px;height:7px;background:var(--gold);border-radius:50%;margin-top:-3px}

/* Map */
.map-section{background:#e9e8df}
.map-layout{display:grid;grid-template-columns:36% 1fr;gap:6%;align-items:center}
.map-section h2{font-size:clamp(73px,6.6vw,105px)}
.map-section-copy>p{max-width:415px;font-size:15px;line-height:1.8;color:#606c64;margin:34px 0 25px}
.map-legend{display:flex;flex-direction:column;gap:14px;margin-bottom:35px}
.map-legend span{font-size:12px;color:#536157;display:flex;align-items:center;gap:10px}
.legend-dot{display:block;width:10px;height:10px;border-radius:50%}
.legend-dot.heritage{background:var(--rust)}
.legend-dot.service{background:var(--forest)}
.map-aside-note{display:flex;align-items:start;gap:8px;color:#758076;font-size:11px;line-height:1.5;margin-top:25px;max-width:300px}
.map-display{background:#fff;padding:12px;box-shadow:0 25px 60px rgba(35,53,45,.11);min-width:0}
.map-display-top{height:38px;display:flex;justify-content:space-between;align-items:center;padding:0 15px;font-size:9px;letter-spacing:.19em;font-weight:700;color:var(--forest)}
.map-explorer{background:#fff;min-width:0;border:1px solid #e3e8e0}
.map-topline{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:15px 18px;color:var(--ink);font-size:10px;font-weight:700;letter-spacing:.15em}
.map-topline>div,.map-topline>a{display:flex;align-items:center;gap:8px}
.map-topline>a{font-size:10px;letter-spacing:0;color:var(--rust)}
.map-live-dot{width:7px;height:7px;background:#aebc83;border-radius:50%}
.map-filters{display:flex;gap:5px;overflow-x:auto;padding:0 14px 10px;scrollbar-width:none}
.map-filters::-webkit-scrollbar{display:none}
.map-filters button{border:1px solid #e0e5df;background:#fff;color:#68776e;font-size:10px;white-space:nowrap;padding:8px 11px;transition:background .2s}
.map-filters button:hover,.map-filters button.active{border-color:var(--forest);background:var(--forest);color:#fff}
.map-canvas-wrap{position:relative;background:#d5dcd2}
.map-canvas{width:100%;height:490px;z-index:0}
.map-explorer.compact .map-canvas{height:385px}
.map-compass{position:absolute;top:14px;right:14px;width:31px;height:31px;background:#fff;z-index:400;display:grid;place-items:center;color:var(--forest);box-shadow:0 2px 9px rgba(0,0,0,.14)}
.map-footer-line{min-height:44px;padding:9px 14px;display:flex;align-items:center;justify-content:space-between;gap:15px;color:#748177;font-size:10px;line-height:1.45}
.map-footer-line span,.map-footer-line a{display:inline-flex;gap:6px;align-items:center}
.map-footer-line a{white-space:nowrap;text-decoration:underline;text-underline-offset:3px}
.ys-marker{background:transparent;border:0}
.ys-marker-pulse{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:rgba(183,101,73,.23);border:1px solid rgba(255,255,255,.75);box-shadow:0 3px 10px rgba(0,0,0,.14)}
.ys-marker-pulse span{width:15px;height:15px;border-radius:50%;background:var(--rust);border:3px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.16)}
.ys-marker-pulse.service{background:rgba(25,63,57,.19)}.ys-marker-pulse.service span{background:var(--forest)}
.ys-marker-pulse.urgent{background:rgba(173,58,48,.21)}.ys-marker-pulse.urgent span{background:#ad3a30}
.leaflet-container{font-family:var(--sans)!important}
.leaflet-control-attribution{font-size:9px!important}
.map-popup{min-width:176px;display:flex;flex-direction:column;gap:6px;font-family:var(--sans)}
.map-popup small{text-transform:uppercase;font-size:9px;letter-spacing:.08em;color:var(--rust)}
.map-popup strong{font-family:var(--serif);font-size:23px;line-height:1}
.map-popup p{margin:0;color:#68736c;font-size:11px;line-height:1.5}
.map-popup a{color:var(--forest);font-weight:700;font-size:10px;margin-top:3px}

/* Safety */
.safety-section{background:var(--paper);padding:125px 0}
.safety-layout{display:grid;grid-template-columns:1fr .88fr;gap:9%;align-items:center}
.safety-copy h2{font-size:clamp(70px,6.4vw,104px)}
.safety-copy>p{max-width:520px;color:#637067;line-height:1.85;font-size:15px;margin:33px 0}
.safety-principles{display:flex;gap:20px;flex-wrap:wrap;margin-top:53px;border-top:1px solid var(--line);padding-top:23px}
.safety-principles div{display:flex;gap:8px;align-items:center;font-size:9px;font-weight:700;letter-spacing:.1em;color:#5b6a60}
.safety-principles svg{color:var(--rust)}
.safety-visual{min-height:545px;background:#a95c46;color:#fff;display:flex;flex-direction:column;justify-content:space-between;padding:31px 37px;position:relative;overflow:hidden}
.safety-visual:before{content:"";position:absolute;width:570px;height:570px;border:1px solid rgba(255,255,255,.18);border-radius:50%;right:-250px;top:-230px;box-shadow:0 0 0 55px rgba(255,255,255,.035),0 0 0 115px rgba(255,255,255,.035)}
.safety-card-top,.safety-card-bottom{display:flex;justify-content:space-between;align-items:center;position:relative;font-size:10px;letter-spacing:.18em;font-weight:700}
.safety-card-top svg{opacity:.8}
.safety-card-middle{position:relative;display:flex;align-items:center;gap:22px;margin-top:45px}
.safety-cross{align-self:flex-start;margin-top:10px;font-size:38px;color:#e6bf90}
.safety-card-middle small{font-size:10px;letter-spacing:.17em;font-weight:700;color:#ffe1bf}
.safety-card-middle strong{font-family:var(--serif);font-size:clamp(140px,15vw,230px);font-weight:500;line-height:.7;letter-spacing:-.08em;display:block;margin:24px 0 30px}
.safety-card-middle strong span{color:#efc490}
.safety-card-middle p{font-size:13px;line-height:1.7;max-width:240px;margin:0}
.safety-card-bottom{border-top:1px solid rgba(255,255,255,.35);padding-top:18px;margin-top:45px}
.safety-card-bottom span:last-child{font-size:21px}

/* Moments */
.moments-section{background:#eeeae0}
.moments-heading{margin-bottom:67px}
.moments-list{border-top:1px solid #cbd0c6}
.moment-row{display:grid;grid-template-columns:75px 75px 1fr 220px;align-items:center;gap:32px;padding:28px 5px;border-bottom:1px solid #cbd0c6;transition:padding .25s,background .25s}
.moment-row:hover{padding-left:16px;background:rgba(255,255,255,.34)}
.moment-index{font-family:var(--serif);font-size:28px;color:var(--rust);align-self:start;display:flex;flex-direction:column;gap:20px}
.moment-index span{font-size:17px}
.moment-icon{width:62px;height:62px;border:1px solid #c9c8b9;border-radius:50%;display:grid;place-items:center;color:var(--rust)}
.moment-content>span{font-size:9px;letter-spacing:.17em;font-weight:700;color:var(--rust)}
.moment-content h3{font-family:var(--serif);font-size:43px;font-weight:500;line-height:1;margin:8px 0}
.moment-content p{color:#6d796f;font-size:12px;line-height:1.6;max-width:560px;margin:0}
.moment-source{display:grid;grid-template-columns:1fr auto;gap:6px;align-items:center;font-size:12px;font-weight:700}
.moment-source svg{color:var(--rust)}
.moment-source small{grid-column:1/-1;font-size:10px;color:#8c968b;font-weight:500}
.moments-disclaimer{display:flex;gap:12px;align-items:center;margin-top:28px;color:#69756a;font-size:11px;line-height:1.5}
.moments-disclaimer>svg{color:var(--rust);flex:none}
.moments-disclaimer a{margin-left:auto;color:var(--rust);font-weight:700;white-space:nowrap;display:flex;gap:8px;align-items:center}

/* Companion band */
.companion-section{background:#23463e;color:#fff;padding:105px 0;overflow:hidden}
.companion-layout{display:grid;grid-template-columns:215px 1fr 315px;gap:55px;align-items:center}
.companion-art{height:260px;position:relative;display:grid;place-items:center}
.companion-sun{width:180px;height:180px;border-radius:50%;border:1px solid rgba(241,224,191,.75);display:grid;place-items:center}
.companion-sun span{font-size:110px;color:#e8c990;line-height:1;transform:rotate(15deg)}
.companion-orbit{position:absolute;border:1px solid rgba(246,231,205,.22);border-radius:50%;width:270px;height:270px;left:-24px;top:-5px}
.companion-orbit.orbit-two{width:340px;height:340px;left:-58px;top:-40px}
.companion-copy h2{font-family:var(--serif);font-size:clamp(57px,5.4vw,81px);font-weight:500;letter-spacing:-.05em;line-height:.86;margin:27px 0 22px}
.companion-copy h2 em{color:#e7c394;font-weight:400}
.companion-copy p{font-size:14px;line-height:1.75;color:#c9d4c8;max-width:560px;margin-bottom:26px}
.companion-prompt-card{background:#f2eee4;color:var(--ink);padding:23px;transform:rotate(2deg);box-shadow:0 14px 35px rgba(0,0,0,.12)}
.companion-prompt-card>div{display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--line);padding-bottom:16px;font-size:10px;letter-spacing:.1em;font-weight:700}
.companion-card-avatar{width:30px;height:30px;display:grid;place-items:center;background:var(--forest);color:#fff;font-size:19px}
.companion-prompt-card>div>span:nth-child(2){display:flex;flex-direction:column;gap:3px}
.companion-prompt-card small{font-size:8px;letter-spacing:.03em;color:var(--muted)}
.companion-prompt-card>div svg{margin-left:auto;color:var(--rust)}
.companion-prompt-card p{font-family:var(--serif);font-size:28px;line-height:1.03;margin:22px 0;color:var(--forest)}
.companion-prompt-card button{border:0;background:none;display:flex;align-items:center;gap:12px;color:var(--rust);padding:0;font-size:12px;font-weight:700}

/* Footer */
.site-footer{background:#102c29;color:#f1efe4;overflow:hidden}
.footer-top{display:grid;grid-template-columns:45% 1fr;gap:6%;padding:103px 0 90px;border-bottom:1px solid rgba(255,255,255,.16)}
.footer-invitation .eyebrow{color:#d1b682}
.footer-invitation h2{font-family:var(--serif);font-size:clamp(69px,6.4vw,105px);line-height:.82;letter-spacing:-.05em;font-weight:500;margin:26px 0 34px}
.footer-invitation h2 em{color:#d6b37e;font-weight:400}
.footer-cta{display:inline-flex;gap:40px;align-items:center;border-bottom:1px solid #dfceb2;padding-bottom:10px;font-size:13px;font-weight:700}
.footer-link-groups{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding-top:8px}
.footer-link-groups>div{display:flex;flex-direction:column;gap:17px}
.footer-link-groups h3{margin:0 0 10px;color:#d4b784;font-size:10px;letter-spacing:.18em;text-transform:uppercase}
.footer-link-groups a{font-size:12px;line-height:1.4;color:#c0cbc0;transition:color .2s;display:inline-flex;align-items:center;gap:5px}
.footer-link-groups a:hover{color:#fff}
.footer-bottom{display:flex;justify-content:space-between;gap:50px;padding:38px 0 30px}
.footer-bottom>div:first-child>p{font-size:12px;color:#9eada2;line-height:1.7;max-width:300px}
.footer-bottom-right{max-width:405px;text-align:right}
.footer-bottom-right>p{font-size:11px;line-height:1.6;color:#aebbb0;margin:5px 0 15px}
.photo-credits{font-size:11px;color:#dfc397}
.photo-credits summary{display:inline-flex;align-items:center;gap:8px;cursor:pointer;list-style:none}
.photo-credits summary::-webkit-details-marker{display:none}
.photo-credits>div{display:flex;flex-direction:column;gap:5px;margin-top:10px}
.photo-credits a:hover{text-decoration:underline}
.footer-rule{padding:20px 0 25px;border-top:1px solid rgba(255,255,255,.13);display:flex;justify-content:space-between;gap:20px;font-size:9px;letter-spacing:.1em;color:#879a8e}
.floating-actions{position:fixed;right:25px;bottom:23px;z-index:50;display:flex;align-items:center;gap:9px}
.floating-actions button{border:0;height:49px;display:flex;align-items:center;justify-content:center;gap:9px;box-shadow:0 8px 26px rgba(14,32,26,.24);font-size:12px;font-weight:700;transition:transform .2s,box-shadow .2s}
.floating-actions button:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(14,32,26,.32)}
.float-chat{background:#fff;color:var(--forest);padding:0 18px}
.float-sos{background:#b1493a;color:#fff;padding:0 19px;letter-spacing:.07em}

/* Chat drawer */
.overlay{position:fixed;inset:0;z-index:110;background:rgba(8,25,23,.58);display:flex;justify-content:flex-end}
.assistant-drawer{height:100dvh;width:min(475px,100%);background:#f9f7f0;display:flex;flex-direction:column;box-shadow:-15px 0 65px rgba(0,0,0,.23)}
.drawer-head{padding:28px 26px 22px;display:flex;align-items:center;gap:13px;border-bottom:1px solid var(--line)}
.assistant-avatar{width:46px;height:46px;flex:none;background:var(--forest);color:#eecb91;display:grid;place-items:center;border-radius:50%}
.drawer-head-title{flex:1}
.drawer-head-title .eyebrow{color:var(--rust)}
.drawer-head-title h2{font-family:var(--serif);font-size:33px;line-height:1;margin:3px 0 0;font-weight:600}
.drawer-head-title p{font-size:11px;color:var(--muted);margin:3px 0 0}
.drawer-close{align-self:flex-start}
.mode-strip{background:#e9eee8;color:var(--forest);padding:11px 27px;font-size:10px;font-weight:700;letter-spacing:.08em;display:flex;align-items:center;gap:8px}
.mode-strip.is-demo{background:#fbefda;color:#8c6024}
.mode-dot{height:7px;width:7px;border-radius:50%;background:#829d79}
.mode-strip.is-demo .mode-dot{background:#d79736}
.chat-messages{padding:22px 22px 28px;overflow-y:auto;flex:1}
.chat-date{text-align:center;font-size:9px;font-weight:700;letter-spacing:.13em;color:#9ba59c;margin:2px 0 27px}
.chat-row{display:flex;gap:9px;align-items:flex-start;margin-bottom:19px}
.chat-row.from-user{justify-content:flex-end}
.chat-mini-avatar{width:24px;height:24px;border-radius:50%;flex:none;background:var(--forest);color:#e0c08c;display:grid;place-items:center;font-size:15px}
.chat-content{max-width:87%}
.chat-bubble{white-space:pre-wrap;background:#fff;color:var(--ink);padding:14px 15px;border:1px solid #e4e9e0;font-size:12px;line-height:1.65;box-shadow:0 2px 9px rgba(31,55,40,.035)}
.from-user .chat-bubble{background:var(--forest);color:#fff;border-color:var(--forest)}
.chat-note{font-size:10px;color:#859187;line-height:1.5;margin:7px 0}
.speak-button{border:0;background:transparent;color:var(--rust);display:flex;align-items:center;gap:5px;padding:7px 0 0;font-size:10px;font-weight:700}
.chat-suggestions{margin:22px 0 0 32px;display:flex;flex-direction:column;align-items:flex-start;gap:8px}
.chat-suggestions>span{font-size:9px;letter-spacing:.16em;font-weight:700;color:#97a096;margin-bottom:3px}
.chat-suggestions button{border:1px solid #d8dfd4;color:var(--forest);background:#fff;padding:9px 11px;font-size:11px;display:flex;gap:11px;align-items:center;text-align:left;transition:border .2s}
.chat-suggestions button:hover{border-color:var(--forest)}
.thinking{display:flex;gap:5px;min-width:57px}
.thinking span{width:5px;height:5px;background:#b5c1b4;border-radius:50%;animation:thinking 1s infinite alternate}
.thinking span:nth-child(2){animation-delay:.2s}.thinking span:nth-child(3){animation-delay:.4s}
@keyframes thinking{to{opacity:.3;transform:translateY(-3px)}}
.chat-bottom{border-top:1px solid var(--line);padding:16px 19px 19px;background:#f5f3eb}
.chat-compose{display:flex;align-items:flex-end;border:1px solid #cfd8ce;background:#fff;padding:8px}
.chat-compose textarea{border:0;outline:0;resize:none;flex:1;min-width:0;max-height:110px;padding:7px 5px;font-size:12px;color:var(--ink)}
.chat-compose textarea::placeholder{color:#9aa59c}
.compose-actions{display:flex;gap:5px;align-items:center}
.compose-actions .icon-button{color:#718175;width:32px;height:32px}
.send-button{width:34px;height:34px;background:var(--forest);color:#fff;border:0;display:grid;place-items:center}
.chat-disclaimer{font-size:10px;line-height:1.5;display:flex;gap:7px;color:#8a968d;margin:11px 0 0}
.chat-disclaimer svg{flex:none}
.chat-error{color:#a44335;background:#fbeae6;padding:8px;font-size:11px;margin:0 0 8px}

/* SOS modal */
.sos-overlay{justify-content:center;align-items:center;padding:24px}
.sos-modal{width:min(1030px,100%);max-height:calc(100dvh - 48px);background:#f9f7f1;display:flex;flex-direction:column;box-shadow:0 30px 85px rgba(0,0,0,.24)}
.sos-modal-head{height:82px;display:flex;align-items:center;gap:13px;padding:0 29px;flex:none;border-bottom:1px solid var(--line)}
.sos-head-icon{width:40px;height:40px;border-radius:50%;background:#f5e5de;color:#a94436;display:grid;place-items:center}
.sos-modal-head h2{font-family:var(--serif);font-size:34px;font-weight:600;margin:0;line-height:1}
.sos-modal-head .eyebrow{color:var(--rust)}
.sos-modal-head>button{margin-left:auto}
.sos-modal-body{display:grid;grid-template-columns:1fr .88fr;overflow-y:auto;min-height:0}
.sos-main{padding:26px 28px 30px}
.emergency-call-card{background:#a7483a;color:#fff;padding:23px 25px;position:relative;overflow:hidden}
.emergency-call-card:after{content:"";border:1px solid rgba(255,255,255,.16);border-radius:50%;position:absolute;width:230px;height:230px;top:-110px;right:-100px}
.emergency-call-card .eyebrow{color:#ffdcc7}
.emergency-call-card h3{font-family:var(--serif);font-size:105px;font-weight:500;line-height:.8;letter-spacing:-.06em;margin:14px 0 12px}
.emergency-call-card p{max-width:300px;font-size:12px;line-height:1.6;margin:0 0 15px}
.call-button{display:flex;justify-content:center;align-items:center;gap:11px;background:#fff;color:#9c3e33;padding:12px;font-weight:700;font-size:13px;position:relative}
.call-button svg:last-child{margin-left:auto}
.emergency-call-card small{display:block;margin-top:10px;opacity:.8;font-size:10px}
.sos-step{padding:23px 0;border-bottom:1px solid var(--line)}
.sos-step-title{display:flex;align-items:center;gap:11px}
.sos-step-title span{font-family:var(--serif);font-size:27px;color:var(--rust)}
.sos-step-title h4{font-size:14px;margin:0}
.sos-step>p{font-size:11px;line-height:1.65;color:var(--muted);margin:8px 0 12px}
.outline-action{display:inline-flex;align-items:center;gap:7px;border:1px solid #c6d0c5;background:transparent;padding:9px 12px;color:var(--forest);font-size:11px;font-weight:700}
.outline-action:hover{background:#e8eee7}
.sos-nearby-buttons{display:flex;gap:8px;flex-wrap:wrap}
.sos-step .inline-status{display:flex;align-items:center;gap:6px;color:#597567;font-size:10px;margin:10px 0 0}
.sos-nearby-list{display:flex;flex-direction:column;max-height:130px;overflow-y:auto;margin-top:10px}
.sos-nearby-list a{font-size:11px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding:7px 0;color:var(--forest)}
.sos-side{background:#efeee6;border-left:1px solid var(--line);padding:27px 28px 30px}
.sos-side-inner>.eyebrow{color:var(--rust)}
.sos-side h3{font-family:var(--serif);font-size:42px;line-height:.95;font-weight:500;margin:9px 0 5px}
.sos-muted{font-size:11px;line-height:1.55;color:var(--muted);margin-bottom:20px}
.field-label{display:block;margin:13px 0 8px;font-size:9px;font-weight:700;letter-spacing:.14em;color:var(--forest);text-transform:uppercase}
.contact-item{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid #e1e5da;margin-bottom:6px;padding:7px 9px}
.contact-item label{display:flex;align-items:center;gap:9px;cursor:pointer;font-size:11px;font-weight:700}
.contact-item input{accent-color:var(--rust)}
.contact-item small{display:block;font-size:9px;font-weight:400;color:var(--muted);margin-top:2px}
.contact-item button{border:0;background:none;color:var(--rust)}
.add-contact{display:grid;grid-template-columns:1fr 1fr auto;gap:5px}
.add-contact input,.sos-side textarea{border:1px solid #d9dfd4;background:#fff;color:var(--ink);outline:0;padding:10px;font-size:11px;min-width:0}
.add-contact button{border:0;background:var(--forest);color:#fff;padding:0 10px;display:flex;align-items:center;gap:3px;font-size:10px;white-space:nowrap}
.muted-caption{display:block;color:#8a948a;font-size:9px;margin-top:7px}
.sos-side textarea{width:100%;resize:vertical}
.prepared-message{background:#fff;border-left:2px solid var(--rust);padding:11px;font-size:10px;line-height:1.55;color:#5f6b63;max-height:90px;overflow:auto;word-break:break-word}
.share-button,.sms-button{width:100%;border:0;background:var(--forest);color:#fff;min-height:38px;display:flex;align-items:center;justify-content:center;gap:8px;font-size:11px;font-weight:700;margin-top:10px}
.share-button svg:last-child,.sms-button svg:last-child{margin-left:auto;margin-right:10px}
.share-button svg:first-child,.sms-button svg:first-child{margin-left:10px}
.sms-button{background:transparent;color:var(--forest);border:1px solid #bdc9be}
.sos-status{display:flex;align-items:flex-start;gap:8px;background:#f8e8d5;color:#805434;padding:10px;font-size:10px;line-height:1.5;margin:12px 0 0}
.sos-status svg{flex:none}
.sos-modal-foot{display:flex;align-items:center;gap:8px;background:#e2e6db;padding:11px 28px;font-size:10px;color:#5e6d61;flex:none}
.sos-modal-foot a{margin-left:auto;color:var(--forest);font-weight:700;display:flex;align-items:center;gap:5px;white-space:nowrap}

/* Destination page */
.detail-hero{height:690px;position:relative;color:#fff;background:var(--forest);isolation:isolate}
.detail-hero>img{z-index:-2;object-fit:cover;object-position:center 52%}
.detail-hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(10,31,30,.69),rgba(10,31,30,.13) 76%),linear-gradient(0deg,rgba(10,30,27,.55),transparent 56%)}
.detail-hero-content{height:100%;display:flex;flex-direction:column;padding-top:130px;padding-bottom:28px}
.detail-back,.plan-back{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;width:max-content}
.detail-hero-main{margin:auto 0 55px}
.light-eyebrow{display:flex;align-items:center;gap:12px;color:#f3d9ac}
.detail-hero-main h1{font-family:var(--serif);font-size:clamp(130px,15vw,215px);line-height:.69;font-weight:500;letter-spacing:-.065em;margin:38px 0 31px}
.detail-hero-main h1 span{color:#dfb377}
.detail-hero-main p{font-family:var(--serif);font-size:35px;line-height:1;margin:0 0 25px}
.detail-hero-actions{display:flex;gap:10px;align-items:center}
.detail-favorite{width:56px;height:56px;border:1px solid #fff;color:#fff;background:transparent;display:grid;place-items:center}
.detail-favorite.saved{background:var(--rust);border-color:var(--rust)}
.detail-hero-caption{display:flex;justify-content:space-between;gap:20px;border-top:1px solid rgba(255,255,255,.38);padding-top:17px;font-size:10px;letter-spacing:.15em;font-weight:700}
.detail-hero-caption a{font-size:9px;opacity:.85}
.detail-anchor-bar{background:#e8e5dc;border-bottom:1px solid var(--line)}
.detail-anchor-bar .container{display:flex;gap:42px;min-height:62px;align-items:center}
.detail-anchor-bar a{font-size:11px;font-weight:700;color:#69776b;white-space:nowrap}
.detail-anchor-bar a:hover{color:var(--rust)}
.detail-overview-layout{display:grid;grid-template-columns:45% 1fr;gap:10%}
.detail-lead{font-family:var(--serif);font-size:39px;line-height:1.1;font-weight:500;margin:6px 0 42px}
.detail-facts{display:grid;grid-template-columns:1fr 1fr;gap:22px 30px;border-top:1px solid var(--line);padding-top:24px}
.detail-facts>div{display:flex;gap:12px;align-items:flex-start}
.detail-facts svg{color:var(--rust);flex:none}
.detail-facts span{font-size:9px;letter-spacing:.14em;color:var(--muted);font-weight:700}
.detail-facts strong{display:block;letter-spacing:0;color:var(--ink);font-size:13px;margin-top:7px}
.detail-overview-note{display:flex;align-items:flex-start;gap:8px;color:#79837a;font-size:11px;line-height:1.6;margin-top:31px}
.detail-overview-note svg{flex:none;color:var(--rust)}
.detail-story-section{background:var(--deep);color:#f3f0e5;padding:115px 0 95px}
.detail-story-heading{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:55px}
.detail-story-heading h2{font-size:clamp(70px,6.8vw,105px);margin-bottom:0}
.detail-story-heading>div:last-child{max-width:365px;padding-bottom:7px}
.detail-story-heading>div:last-child p{font-size:15px;line-height:1.7;color:#d0d8ca}
.detail-story-heading>div:last-child span{font-size:9px;letter-spacing:.15em;color:#d7b986}
.storyboard{display:grid;grid-template-columns:45% 55%;min-height:500px;border:1px solid rgba(255,255,255,.18)}
.storyboard-photo{position:relative;min-height:500px;background:#57665c;overflow:hidden}
.storyboard-photo img{object-fit:cover;opacity:.9}
.storyboard-photo>div{position:absolute;left:22px;bottom:21px;background:rgba(18,45,42,.9);font-size:9px;letter-spacing:.16em;padding:9px 12px}
.storyboard-content{padding:47px 55px 33px;display:flex;flex-direction:column;align-items:flex-start}
.storyboard-content>.eyebrow{color:#d4b983}
.storyboard-date{font-family:var(--serif);font-size:114px;line-height:.85;color:#d2b07b;margin:45px 0 8px;letter-spacing:-.06em}
.storyboard-content h3{font-family:var(--serif);font-size:47px;font-weight:500;line-height:.98;margin:0 0 18px}
.storyboard-content>p{font-size:14px;line-height:1.7;color:#c2cec3;max-width:500px;margin:0}
.storyboard-controls{display:flex;align-items:center;gap:15px;flex-wrap:wrap;margin-top:24px}
.storyboard-play{border:1px solid #d3b883;background:none;color:#f3ead8;padding:11px 14px;display:flex;gap:9px;align-items:center;font-size:11px;font-weight:700}
.storyboard-controls>span{display:flex;align-items:center;gap:6px;color:#a7b9ad;font-size:10px}
.storyboard-progress{display:flex;gap:8px;width:100%;margin-top:auto;padding-top:33px}
.storyboard-progress button{flex:1;border:0;border-top:1px solid rgba(255,255,255,.25);background:none;color:#aab9ac;text-align:left;padding:11px 0;font-family:var(--serif);font-size:21px}
.storyboard-progress button.active{border-color:var(--gold);color:#f4e3c4}
.detail-story-after{display:grid;grid-template-columns:1fr 1fr;gap:12%;margin:52px 0;border-bottom:1px solid rgba(255,255,255,.17);padding-bottom:48px}
.detail-story-after>p{font-family:var(--serif);font-size:33px;line-height:1.19;margin:0}
.detail-story-after>div>span,.story-sources>span{font-size:10px;letter-spacing:.17em;color:#d6b782;font-weight:700}
.detail-story-after>div>p{font-size:13px;line-height:1.9;color:#b9c9bc;max-width:490px}
.story-sources{display:flex;align-items:center;gap:22px;flex-wrap:wrap}
.story-sources>a{font-size:12px;display:flex;gap:5px;align-items:center;text-decoration:underline;text-underline-offset:4px}
.story-sources>small{width:100%;font-size:10px;color:#92a79a}
.detail-map-section{background:#e9e8df}
.detail-section-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:50px}
.detail-section-heading>p{font-size:15px;line-height:1.75;max-width:355px;color:#69776c}
.detail-map-layout{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(290px,.7fr);gap:25px;align-items:start}
.detail-map-aside{background:#f8f6ed;padding:32px;min-height:600px}
.detail-map-aside>.eyebrow{color:var(--rust)}
.detail-map-aside h3{font-family:var(--serif);font-size:49px;font-weight:500;line-height:.95;margin:15px 0 8px}
.detail-map-aside>p{color:var(--muted);font-size:12px;line-height:1.7}
.detail-day-ideas{margin:28px 0;border-top:1px solid var(--line)}
.detail-day-ideas>div{display:flex;gap:16px;border-bottom:1px solid var(--line);padding:17px 0}
.detail-day-ideas>div>span{font-family:var(--serif);font-size:30px;color:var(--rust)}
.detail-day-ideas strong{font-size:12px}
.detail-day-ideas p{font-size:11px;line-height:1.5;color:var(--muted);margin:5px 0 0}
.detail-transport-note{display:flex;gap:9px;align-items:flex-start;border-top:1px solid var(--line);margin-top:30px;padding-top:19px;color:#748077;font-size:10px;line-height:1.5}
.detail-transport-note svg{flex:none;color:var(--rust)}
.detail-etiquette-section{background:var(--paper)}
.detail-etiquette-layout{display:grid;grid-template-columns:1fr 1fr;gap:10%}
.detail-etiquette-layout>div:first-child>p{font-size:15px;line-height:1.8;color:var(--muted);max-width:455px;margin:28px 0}
.etiquette-list{padding-top:12px}
.etiquette-list>span,.access-note>span{font-size:10px;letter-spacing:.17em;font-weight:700;color:var(--rust)}
.etiquette-list>div:not(.access-note){display:flex;align-items:flex-start;gap:18px;border-bottom:1px solid var(--line);padding:23px 0}
.etiquette-list>div>span{font-family:var(--serif);font-size:25px;color:var(--rust)}
.etiquette-list>div>p{flex:1;font-size:14px;line-height:1.55;margin:0}
.etiquette-list>div>svg{flex:none;color:#879c85}
.access-note{background:#e7e8de;padding:25px;margin-top:27px}
.access-note p{font-size:12px;line-height:1.7;color:#4f6055;margin:11px 0 0}
.detail-next{background:#aa6048;color:#fff;padding:77px 0}
.detail-next>.container{display:flex;justify-content:space-between;align-items:end;gap:30px}
.detail-next .eyebrow{color:#f5d6af}
.detail-next h2{font-family:var(--serif);font-size:78px;line-height:.86;letter-spacing:-.05em;font-weight:500;margin:20px 0 0}
.detail-next h2 em{font-weight:400;color:#f6dfbd}

/* Planner */
.plan-page{background:var(--paper)}
.plan-intro{padding:152px 0 72px;background:#eeeae0}
.plan-back{color:var(--rust);margin-bottom:48px}
.plan-intro h1,.full-map-heading h1,.info-hero h1{font-family:var(--serif);font-size:clamp(83px,9vw,135px);font-weight:500;line-height:.85;letter-spacing:-.055em;margin:26px 0 16px}
.plan-intro h1 em,.full-map-heading h1 em{color:var(--rust);font-weight:400}
.plan-intro p,.full-map-heading p{color:#657168;max-width:560px;font-size:15px;line-height:1.7;margin:0}
.plan-layout{display:grid;grid-template-columns:300px 1fr;gap:65px;padding-top:75px;padding-bottom:100px;align-items:start}
.plan-sidebar{background:var(--deep);color:#f3efe5;position:sticky;top:25px;padding:28px;min-height:495px;display:flex;flex-direction:column;overflow:hidden}
.plan-sidebar:before{content:"";position:absolute;width:280px;height:280px;border:1px solid rgba(255,255,255,.12);border-radius:50%;right:-120px;top:30px}
.plan-sidebar-top>span{font-size:9px;letter-spacing:.2em;color:#d4b682;font-weight:700}
.plan-side-compass{font-size:72px;color:#d7b98a;line-height:1;margin:36px 0 5px;position:relative}
.plan-sidebar h2{font-family:var(--serif);font-size:45px;line-height:.9;letter-spacing:-.025em;font-weight:500;margin:12px 0}
.plan-sidebar p{font-size:11px;line-height:1.7;color:#b8c9bc}
.plan-sidebar-steps{margin-top:35px;display:flex;flex-direction:column;gap:0}
.plan-sidebar-steps div{border-top:1px solid rgba(255,255,255,.19);padding:12px 0;display:flex;gap:18px;align-items:center;font-size:11px}
.plan-sidebar-steps span{font-family:var(--serif);font-size:25px;color:#d6b481}
.plan-sidebar-bottom{display:flex;gap:10px;border-top:1px solid rgba(255,255,255,.19);padding-top:18px;margin-top:auto}
.plan-sidebar-bottom svg{flex:none;color:#d6b481}
.plan-sidebar-bottom p{margin:0}
.plan-form-section{padding:0 0 52px;margin-bottom:47px;border-bottom:1px solid var(--line)}
.plan-step-title>span{font-size:10px;letter-spacing:.2em;font-weight:700;color:var(--rust)}
.plan-step-title h2,.plan-preview-head h2,.saved-trip-head h2,.plan-bottom-cta h2{font-family:var(--serif);font-size:54px;line-height:1;font-weight:500;margin:10px 0}
.plan-step-title p,.plan-preview-head p,.saved-trip-head p{color:var(--muted);line-height:1.7;font-size:12px;max-width:580px;margin:0 0 22px}
.plan-destinations{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.plan-destination{height:105px;border:2px solid transparent;background:#566960;position:relative;overflow:hidden;color:#fff;text-align:left;padding:13px;display:flex;align-items:end}
.plan-destination img{object-fit:cover;z-index:0;transition:transform .3s}
.plan-destination:hover img{transform:scale(1.08)}
.plan-destination.selected{border-color:#e9ba83}
.plan-destination-shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(13,28,27,.7),transparent 85%);z-index:1}
.plan-destination strong{z-index:2;font-family:var(--serif);font-size:24px;line-height:1}
.plan-destination-check{position:absolute;z-index:2;right:10px;top:10px;width:23px;height:23px;display:grid;place-items:center;border:1px solid #fff;background:rgba(11,31,27,.35)}
.plan-destination.selected .plan-destination-check{background:var(--rust);border-color:var(--rust)}
.favorite-hint{display:flex;align-items:center;gap:7px;color:var(--rust);font-size:10px;margin:13px 0 0}
.plan-date-fields{display:flex;align-items:end;gap:13px;flex-wrap:wrap}
.plan-date-fields label{display:flex;flex-direction:column;gap:9px;font-size:9px;letter-spacing:.16em;font-weight:700;color:var(--muted)}
.plan-date-fields label>span{display:flex;align-items:center;gap:8px;border:1px solid #d4dace;background:#fff;padding:10px;color:var(--rust)}
.plan-date-fields input{border:0;outline:0;color:var(--ink);font-size:12px;background:none}
.date-connector{padding-bottom:11px;font-family:var(--serif);font-size:28px;color:var(--rust)}
.plan-day-count{display:flex;align-items:center;gap:6px;color:var(--forest);font-size:11px;font-weight:700;padding-bottom:14px;margin-left:auto}
.plan-input-label{display:block;color:var(--rust);font-size:10px;letter-spacing:.14em;font-weight:700;margin:24px 0 11px}
.plan-choice-row{display:flex;gap:9px}
.plan-choice-row button{flex:1;display:flex;flex-direction:column;align-items:flex-start;gap:5px;background:transparent;border:1px solid #d3d9cf;padding:13px;text-align:left;color:var(--ink)}
.plan-choice-row button.selected{background:var(--forest);border-color:var(--forest);color:#fff}
.plan-choice-row strong{font-size:12px}.plan-choice-row small{font-size:10px;opacity:.7}
.plan-interest-row{display:flex;gap:8px;flex-wrap:wrap}
.plan-interest-row button{border:1px solid #d3d9cf;background:transparent;color:var(--muted);padding:8px 11px;font-size:11px;display:flex;align-items:center;gap:5px}
.plan-interest-row button.selected{border-color:var(--rust);color:var(--rust);background:#f8e9e0}
.plan-select-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:24px}
.plan-select-grid label{display:flex;flex-direction:column;gap:8px;color:var(--muted);font-size:9px;font-weight:700;letter-spacing:.12em}
.plan-select-grid select{max-width:100%;border:1px solid #d3d9cf;background:#fff;color:var(--ink);padding:10px 7px;font-size:11px;letter-spacing:0}
.plan-access-toggle{display:flex;gap:10px;align-items:flex-start;padding:17px;background:#e9ebe2;margin-top:20px;cursor:pointer}
.plan-access-toggle input{accent-color:var(--rust);margin-top:3px}
.plan-access-toggle span{display:flex;flex-direction:column;gap:4px}
.plan-access-toggle strong{font-size:12px}
.plan-access-toggle small{color:var(--muted);font-size:10px;line-height:1.5}
.plan-language-note{font-size:10px;color:#879187;line-height:1.55;margin:14px 0 0}
.plan-generate-bar{display:flex;align-items:center;justify-content:space-between;gap:20px;background:#e9e6db;padding:19px 21px}
.plan-generate-bar>div{display:flex;gap:11px;align-items:center;color:var(--rust)}
.plan-generate-bar>div>span{font-size:12px;font-weight:700;color:var(--ink)}
.plan-generate-bar small{display:block;color:var(--muted);font-size:10px;font-weight:400;margin-top:3px}
.plan-notice{display:flex;gap:8px;align-items:flex-start;background:#f7eddc;color:#755d3e;padding:12px 15px;margin-top:15px;font-size:11px;line-height:1.5}
.plan-notice svg{flex:none}
.plan-preview{padding-top:77px;scroll-margin-top:30px}
.plan-preview-head{display:flex;justify-content:space-between;align-items:end;gap:15px}
.plan-preview-head .eyebrow{color:var(--rust)}
.plan-preview-head>button,.saved-trip-head>button{border:0;background:none;color:var(--rust);display:flex;gap:6px;align-items:center;font-size:11px;font-weight:700;padding:7px}
.plan-days{display:flex;flex-direction:column;gap:20px;margin-top:23px}
.plan-day{border:1px solid #d6dcd1;background:#fff}
.plan-day-header{display:flex;align-items:center;gap:15px;background:var(--forest);color:#fff;padding:18px 22px}
.plan-day-header>span{font-size:10px;letter-spacing:.16em;color:#dfc49b}
.plan-day-header h3{font-family:var(--serif);font-size:31px;line-height:1;margin:0;font-weight:500}
.plan-day-header time{margin-left:auto;font-size:10px;color:#c2d3c3}
.plan-stops{padding:8px 20px}
.plan-stop{display:grid;grid-template-columns:40px 1fr 15px;gap:11px;padding:16px 0;border-bottom:1px solid #e8ece5;align-items:start}
.plan-stop:last-child{border-bottom:0}
.plan-stop-number{font-family:var(--serif);font-size:29px;color:var(--rust)}
.plan-stop>div:nth-child(2){display:grid;grid-template-columns:140px 1fr;gap:10px 12px}
.plan-stop label{display:flex;flex-direction:column;gap:4px;font-size:9px;letter-spacing:.12em;color:var(--muted);font-weight:700}
.plan-stop input,.plan-stop textarea{border:1px solid transparent;background:#f7f7f1;color:var(--ink);font-size:12px;letter-spacing:0;padding:8px;width:100%;outline:0}
.plan-stop input:focus,.plan-stop textarea:focus{border-color:var(--rust)}
.plan-stop textarea{grid-column:1/-1;resize:vertical;line-height:1.5}
.plan-stop>svg{color:#9fa9a0;margin-top:5px}
.plan-save-bar{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:23px}
.plan-save-bar p{display:flex;align-items:start;gap:8px;font-size:10px;line-height:1.5;color:var(--muted);max-width:340px}
.plan-save-bar p svg{flex:none;color:var(--rust)}
.saved-trip-section{border-top:1px solid var(--line);padding:75px 0 90px}
.saved-trip-head{display:flex;justify-content:space-between;align-items:end;gap:20px}
.saved-trip-head h2{margin-top:25px}
.saved-trip-list{border-top:1px solid var(--line);margin-top:23px}
.saved-trip{display:flex;align-items:center;gap:19px;border-bottom:1px solid var(--line);padding:17px 0}
.saved-trip-symbol{width:46px;height:46px;background:var(--forest);color:#dec090;display:grid;place-items:center;font-size:25px;flex:none}
.saved-trip>div:nth-child(2){flex:1}
.saved-trip>div:nth-child(2)>span{font-size:9px;color:var(--rust);letter-spacing:.1em}
.saved-trip h3{font-family:var(--serif);font-size:28px;font-weight:600;margin:2px 0}
.saved-trip p{font-size:10px;color:var(--muted);margin:0}
.saved-trip button{border:0;background:none;color:var(--forest);display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700}
.saved-trip button:last-child{color:var(--rust)}
.saved-empty{border:1px solid var(--line);padding:28px;display:flex;align-items:center;gap:14px;color:var(--muted);font-size:12px;margin-top:22px}
.saved-empty svg{color:var(--rust)}
.plan-bottom-cta{display:flex;align-items:center;justify-content:space-between;gap:30px;border-top:1px solid var(--line);padding-top:48px;padding-bottom:85px}
.plan-bottom-cta>div>span{font-size:9px;letter-spacing:.18em;color:var(--rust);font-weight:700}
.plan-bottom-cta p{font-size:12px;color:var(--muted);margin:0}

/* Full map page */
.full-map-page{background:#eeeae0}
.full-map-heading{padding-top:153px;padding-bottom:58px}
.full-map-title-row{display:flex;justify-content:space-between;align-items:center;gap:30px}
.full-map-heading h1{margin:22px 0 15px}
.map-page-compass{width:135px;height:135px;border:1px solid #c7cec1;border-radius:50%;display:grid;place-items:center;color:var(--rust);position:relative}
.map-page-compass:after{content:"N";position:absolute;top:6px;font-size:10px;font-weight:700}
.full-map-layout{display:grid;grid-template-columns:280px 1fr;gap:25px;padding-bottom:100px}
.full-map-sidebar{background:var(--deep);color:#fff;padding:24px;align-self:start}
.full-map-sidebar>.eyebrow{color:#dbba86}
.map-city-list{margin:21px 0 31px}
.map-city-list button{border:0;border-bottom:1px solid rgba(255,255,255,.16);background:none;color:#c8d1c5;width:100%;display:flex;gap:12px;align-items:center;text-align:left;padding:13px 3px}
.map-city-list button.active{color:#f0d09c}
.map-city-list button span{font-family:var(--serif);font-size:23px;color:#d6b783}
.map-city-list button strong{font-family:var(--serif);font-size:27px;font-weight:500;flex:1}
.map-sidebar-info{border-top:1px solid rgba(255,255,255,.22);padding-top:20px}
.map-sidebar-info>span{font-size:9px;letter-spacing:.15em;color:#d6b783}
.map-sidebar-info h2{font-family:var(--serif);font-size:38px;font-weight:500;margin:10px 0}
.map-sidebar-info p{font-size:11px;line-height:1.7;color:#b8c9bd}
.map-sidebar-info a{display:flex;align-items:center;gap:9px;font-size:11px;font-weight:700;color:#e0c08e;margin-top:19px}
.full-map-main{min-width:0}
.full-map-under{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:14px;background:#dfdfd2;padding:16px}
.full-map-under>div{display:flex;gap:10px;align-items:start;max-width:550px}
.full-map-under svg{flex:none;color:var(--rust)}
.full-map-under p{font-size:10px;line-height:1.5;color:#677568;margin:0}
.full-map-under strong{color:var(--ink)}
.full-map-under button{border:0;background:var(--forest);color:#fff;padding:11px 13px;white-space:nowrap;display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700}
.full-map-resources{display:flex;justify-content:space-between;gap:80px;border-top:1px solid var(--line);padding-bottom:100px;padding-top:58px}
.full-map-resources h2{font-family:var(--serif);font-size:55px;font-weight:500;line-height:.96;margin:18px 0}
.full-map-resources h2 em{color:var(--rust)}
.full-map-resources>div:last-child{max-width:395px}
.full-map-resources p{font-size:12px;line-height:1.8;color:var(--muted)}
.full-map-resources button,.full-map-resources a{border:0;background:none;display:flex;align-items:center;gap:10px;color:var(--forest);font-size:12px;font-weight:700;padding:8px 0}
.full-map-resources a{color:var(--rust)}

/* Information pages */
.info-page{background:var(--paper);padding-bottom:110px}
.info-hero{padding-top:155px;padding-bottom:58px;border-bottom:1px solid var(--line)}
.info-hero h1{font-size:clamp(78px,8vw,118px);max-width:1000px}
.info-hero>p{font-family:var(--serif);font-size:32px;line-height:1.2;max-width:780px;color:#68756b;margin:26px 0 0}
.info-content{display:grid;grid-template-columns:275px 1fr;gap:95px;padding-top:67px}
.info-index{font-size:10px;letter-spacing:.17em;font-weight:700;color:var(--rust);display:flex;flex-direction:column;gap:18px}
.info-index span:last-child{color:#98a49a}
.info-sections{grid-column:2}
.info-sections section{display:grid;grid-template-columns:53px 1fr;gap:15px;border-bottom:1px solid var(--line);padding:0 0 27px;margin-bottom:30px}
.info-sections section>span{font-family:var(--serif);font-size:32px;color:var(--rust)}
.info-sections h2{font-family:var(--serif);font-size:39px;line-height:1;font-weight:500;margin:4px 0 13px}
.info-sections p{font-size:14px;line-height:1.8;color:#68756c;margin:0;max-width:670px}
.info-actions{grid-column:2;display:flex;gap:18px;flex-wrap:wrap}
.info-actions a{display:flex;align-items:center;gap:9px;background:var(--forest);color:#fff;padding:12px 14px;font-size:11px;font-weight:700}
.info-actions a:nth-child(2){background:#e7e9df;color:var(--forest)}
.info-actions a:nth-child(3){background:#a84938}
.info-official{grid-column:2;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:19px 0;border-top:1px solid var(--line);margin-top:15px}
.info-official span{font-size:10px;letter-spacing:.14em;color:var(--muted)}
.info-official a{display:flex;align-items:center;gap:6px;color:var(--rust);font-size:11px;font-weight:700}

.map-external-fallback{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:10px 14px;border-top:1px solid #e3e8e0;background:#f7f7f1;font-size:10px;color:#677569}
.map-external-fallback>a{display:inline-flex;align-items:center;gap:5px;color:var(--rust);font-weight:700}
.map-external-fallback small{width:100%;font-size:9px;color:#899489}
.sos-external-link{display:flex;align-items:center;gap:6px;flex-wrap:wrap;color:var(--rust);font-size:11px;font-weight:700;margin-top:10px}
.sos-external-link small{width:100%;color:#8a958a;font-size:9px;font-weight:400}

