"use client";
import { useEffect, useMemo, useRef, useState } from "react";
import { ArrowUpRight, Compass, ExternalLink, MapPin } from "lucide-react";
const filters = [
  { id: "Attraction", label: "Landmarks" },
  { id: "Transport", label: "Transport" },
  { id: "hospital", label: "Hospitals" },
  { id: "police", label: "Police" },
  { id: "pharmacy", label: "Pharmacies" },
  { id: "restaurant", label: "Food" },
  { id: "hotel", label: "Stays" },
];
export function MapExplorer({ destination, compact = false }) {
  const mapNode = useRef(null);
  const [filter, setFilter] = useState("Attraction");
  const [livePlaces, setLivePlaces] = useState([]);
  const [status, setStatus] = useState("");
  const isLive = !["Attraction", "Transport"].includes(filter);
  const markers = useMemo(
    () =>
      isLive
        ? livePlaces
        : destination.places.filter((place) => place.kind === filter),
    [destination, filter, isLive, livePlaces],
  );
  useEffect(() => {
    if (!isLive) {
      setStatus("");
      setLivePlaces([]);
      return;
    }
    const controller = new AbortController();
    setStatus("Loading community map listings…");
    setLivePlaces([]);
    fetch(
      `/api/nearby?lat=${destination.coordinates[0]}&lng=${destination.coordinates[1]}&kind=${filter}`,
      { signal: controller.signal },
    )
      .then(async (response) => {
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Map lookup failed.");
        return data;
      })
      .then((data) => {
        setLivePlaces(data.places ?? []);
        setStatus(
          data.places?.length
            ? `${data.places.length} OpenStreetMap listings · community-edited, not verified by YatraSathi`
            : "No map listings found here. Data may be incomplete.",
        );
      })
      .catch((error) => {
        if (controller.signal.aborted) return;
        setStatus(
          error instanceof Error ? error.message : "Map listings unavailable.",
        );
      });
    return () => controller.abort();
  }, [destination, filter, isLive]);
  useEffect(() => {
    let cancelled = false;
    let mapInstance = null;
    async function drawMap() {
      const L = await import("leaflet");
      if (cancelled || !mapNode.current) return;
      const map = L.map(mapNode.current, {
        zoomControl: false,
        scrollWheelZoom: false,
        attributionControl: true,
      }).setView(destination.coordinates, compact ? 12 : 13);
      mapInstance = map;
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);
      L.control.zoom({ position: "bottomright" }).addTo(map);
      markers.forEach((place) => {
        const kind = "kind" in place ? place.kind : filter;
        const tone =
          kind === "hospital" || kind === "police"
            ? "urgent"
            : kind === "Attraction"
              ? "heritage"
              : "service";
        const icon = L.divIcon({
          className: "ys-marker",
          html: `<span class="ys-marker-pulse ${tone}"><span></span></span>`,
          iconSize: [38, 38],
          iconAnchor: [19, 19],
        });
        const popup = document.createElement("div");
        popup.className = "map-popup";
        const category = document.createElement("small");
        category.textContent =
          kind === "Attraction" || kind === "Transport"
            ? kind
            : `${kind} · OSM listing, unverified`;
        const title = document.createElement("strong");
        title.textContent = place.name;
        const note = document.createElement("p");
        note.textContent =
          "note" in place
            ? place.note
            : place.address ||
              "Confirm details with the place before visiting.";
        const link = document.createElement("a");
        link.textContent = "View on OpenStreetMap ↗";
        link.href = `https://www.openstreetmap.org/?mlat=${place.lat}&mlon=${place.lng}#map=17/${place.lat}/${place.lng}`;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        popup.append(category, title, note, link);
        L.marker([place.lat, place.lng], { icon }).addTo(map).bindPopup(popup);
      });
      window.setTimeout(() => {
        if (!cancelled) map.invalidateSize();
      }, 120);
    }
    void drawMap();
    return () => {
      cancelled = true;
      mapInstance?.remove();
    };
  }, [destination, markers, compact, filter]);
  return (
    <div className={`map-explorer ${compact ? "compact" : ""}`}>
      <div className="map-topline">
        <div>
          <span className="map-live-dot" /> EXPLORING{" "}
          {destination.name.toUpperCase()}
        </div>
        <a
          href={`https://www.openstreetmap.org/?mlat=${destination.coordinates[0]}&mlon=${destination.coordinates[1]}#map=13/${destination.coordinates[0]}/${destination.coordinates[1]}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in OSM <ArrowUpRight size={14} />
        </a>
      </div>
      <div className="map-filters" role="group" aria-label="Map place types">
        {filters.map((item) => (
          <button
            key={item.id}
            type="button"
            className={filter === item.id ? "active" : ""}
            onClick={() => setFilter(item.id)}
          >
            {item.label}
          </button>
        ))}
      </div>
      <div className="map-canvas-wrap">
        <div
          ref={mapNode}
          className="map-canvas"
          role="img"
