                aria-label="Choose interface language"
              >
                <option value="en">EN</option>
                <option value="hi">हिंदी</option>
              </select>
            </label>
            <Link href="/plan" className="header-plan">
              {t("nav.plan")} <ArrowUpRight size={16} />
            </Link>
            <button
              type="button"
