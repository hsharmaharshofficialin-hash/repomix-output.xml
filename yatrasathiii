import { aiMode, getAIProvider } from "@/lib/ai-provider";
import { getDestination } from "@/lib/destinations";
import { isSameOrigin } from "@/lib/request-security";

export const dynamic = "force-dynamic";

// Lightweight per-process rate limiting for the hackathon prototype.
// Production deployment needs a shared store if multiple servers are used.
const requests = new Map();

export async function GET() {
  return Response.json({ mode: aiMode() });
}

export async function POST(request) {
  if (!isSameOrigin(request)) {
    return Response.json({ error: "Invalid origin." }, { status: 403 });
  }

  const ip =
    request.headers.get("x-forwarded-for")?.split(",")[0]?.trim() || "local";
  const now = Date.now();
  const previous = requests.get(ip);
  const bucket =
    !previous || previous.reset < now
      ? { count: 0, reset: now + 15 * 60 * 1000 }
      : previous;
  bucket.count += 1;
  if (requests.size > 1000) requests.clear();
  requests.set(ip, bucket);
  if (bucket.count > 30) {
    return Response.json(
      { error: "Please take a short break before asking more questions." },
      { status: 429 },
    );
  }

  try {
    const raw = await request.text();
    if (raw.length > 12000)
      return Response.json({ error: "Message is too long." }, { status: 413 });

    const body = JSON.parse(raw);
    const messages = body?.messages;
    const validMessages =
      Array.isArray(messages) &&
      messages.length > 0 &&
      messages.length <= 10 &&
      messages.every(
        (message) =>
          message &&
          typeof message === "object" &&
          ["user", "assistant"].includes(message.role) &&
          typeof message.content === "string" &&
          message.content.trim().length > 0 &&
          message.content.length <= 1400,
      ) &&
      messages.at(-1).role === "user";

    if (!validMessages) {
      return Response.json(
        { error: "Please send a shorter, valid question." },
        { status: 400 },
      );
    }
    if (
      body.destination !== undefined &&
      (typeof body.destination !== "string" ||
        !getDestination(body.destination))
    ) {
      return Response.json({ error: "Unknown destination." }, { status: 400 });
    }

    const result = await getAIProvider().respond({
      messages,
      destination: body.destination,
      language: body.language === "hi" ? "hi" : "en",
    });
    return Response.json(result);
  } catch (error) {
    if (error instanceof SyntaxError)
      return Response.json({ error: "Invalid JSON." }, { status: 400 });
    // Never claim that a failed live request was answered by the demo provider.
    return Response.json(
      { error: "The companion is unavailable right now. Please try again." },
      { status: 502 },
    );
  }
}
