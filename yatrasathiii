  const suggestions = t("assistant.suggestions", { returnObjects: true });
  return (
    <div className="overlay" onMouseDown={onClose}>
      <section
        className="assistant-drawer"
        role="dialog"
        aria-modal="true"
        aria-label={t("assistant.title")}
        onMouseDown={(event) => event.stopPropagation()}
      >
        <div className="drawer-head">
          <div className="assistant-avatar">
            <Sparkles size={22} strokeWidth={1.7} />
          </div>
          <div className="drawer-head-title">
            <span className="eyebrow small-eyebrow">
              {t("assistant.label")}
            </span>
            <h2>{t("assistant.title")}</h2>
            <p>{t("assistant.subtitle")}</p>
          </div>
          <button
            className="icon-button drawer-close"
            type="button"
            onClick={onClose}
            aria-label={t("common.close")}
          >
            <X size={21} />
          </button>
        </div>
        <div className={`mode-strip ${mode === "demo" ? "is-demo" : ""}`}>
          <span className="mode-dot" />
          {mode === "checking"
            ? "Checking connection…"
            : mode === "unknown"
              ? "CONNECTION STATUS UNAVAILABLE"
              : mode === "live"
                ? t("assistant.live")
                : t("assistant.demo")}
        </div>
        <div className="chat-messages" aria-live="polite">
          <p className="chat-date">TODAY · YOUR JOURNEY STARTS HERE</p>
          {messages.map((message, index) => (
            <div
              key={index}
              className={`chat-row ${message.role === "user" ? "from-user" : "from-sathi"}`}
            >
              {message.role === "assistant" && (
                <span className="chat-mini-avatar">✳</span>
              )}
              <div className="chat-content">
                <div className="chat-bubble">{message.content}</div>
                {message.note && <p className="chat-note">{message.note}</p>}
                {message.role === "assistant" && (
                  <button
                    className="speak-button"
                    type="button"
                    onClick={() => speak(message.content)}
                    aria-label="Read response aloud"
                  >
                    <AudioLines size={14} /> Listen
                  </button>
                )}
              </div>
            </div>
          ))}
          {messages.length === 1 && (
            <div className="chat-suggestions">
              <span>TRY ASKING</span>
              {suggestions.map((suggestion) => (
                <button
                  type="button"
                  key={suggestion}
                  onClick={() => void sendMessage(suggestion)}
                >
                  {suggestion}
                  <ArrowUp size={13} />
                </button>
              ))}
            </div>
          )}
          {busy && (
            <div className="chat-row from-sathi">
              <span className="chat-mini-avatar">✳</span>
              <div className="chat-bubble thinking">
                <span />
                <span />
                <span />
              </div>
            </div>
          )}
          <div ref={bottomRef} />
        </div>
        <div className="chat-bottom">
          {error && (
            <p className="chat-error" role="alert">
              {error}
            </p>
          )}
          <form className="chat-compose" onSubmit={handleSubmit}>
            <textarea
              ref={inputRef}
              value={input}
              onChange={(event) => setInput(event.target.value)}
              onKeyDown={(event) => {
                if (event.key === "Enter" && !event.shiftKey) {
                  event.preventDefault();
                  void sendMessage(input);
                }
              }}
              maxLength={1400}
              rows={2}
              placeholder={t("assistant.placeholder")}
              aria-label={t("assistant.placeholder")}
            />
            <div className="compose-actions">
              {speechAvailable && (
                <button
                  type="button"
                  className="icon-button"
                  onClick={listen}
                  aria-label="Use microphone"
                >
                  <Mic size={19} />
                </button>
              )}
              <button
                type="submit"
                className="send-button"
                disabled={!input.trim() || busy}
                aria-label={t("assistant.send")}
              >
                <ArrowUp size={20} />
              </button>
            </div>
          </form>
          <p className="chat-disclaimer">
            <ShieldCheck size={13} />
            {t("assistant.disclaimer")}
          </p>
        </div>
      </section>
    </div>
  );
}
