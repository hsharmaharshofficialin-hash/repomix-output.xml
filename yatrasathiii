          <path
            d="M24 3.5 29.7 17 43 24l-13.3 6.8L24 44.5l-5.8-13.7L5 24l13.2-7L24 3.5Z"
            stroke="currentColor"
            strokeWidth="1.5"
          />
          <path
            d="M14.8 24h18.4M24 14.7v18.6"
            stroke="currentColor"
            strokeWidth="1.2"
          />
