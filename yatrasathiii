import { drizzle } from "drizzle-orm/node-postgres";
import { Pool } from "pg";

const databaseUrl = process.env.DATABASE_URL;
if (!databaseUrl) {
  throw new Error("DATABASE_URL is required. Put it in your local .env file.");
}

// Next.js reloads server modules while developing. Reuse the pool to avoid
// opening a new PostgreSQL connection on every reload.
const globalForDb = globalThis;
export const pool =
  globalForDb.__yatrasathiDbPool ??
  new Pool({
    connectionString: databaseUrl,
  });

if (process.env.NODE_ENV !== "production") {
  globalForDb.__yatrasathiDbPool = pool;
}

export const db = drizzle(pool);
