"use client";
import {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useState,
  useSyncExternalStore,
} from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import { useTranslation } from "react-i18next";
import {
  ArrowRight,
  ArrowUpRight,
  Globe2,
  Menu,
  MessageCircleMore,
  ShieldAlert,
  X,
} from "lucide-react";
