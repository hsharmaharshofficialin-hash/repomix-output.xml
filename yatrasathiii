"use client";
import { useEffect, useState } from "react";
import { useTranslation } from "react-i18next";
import {
  AlertCircle,
  ArrowUpRight,
  Check,
  Copy,
  Cross,
  Hospital,
  MapPin,
  Phone,
  Plus,
  Send,
  ShieldAlert,
  Trash2,
  X,
} from "lucide-react";
import "@/lib/i18n";
export function SosModal({ open, onClose }) {
  const { t } = useTranslation();
  const [position, setPosition] = useState(null);
  const [locationState, setLocationState] = useState("");
  const [contacts, setContacts] = useState([]);
  const [selectedContact, setSelectedContact] = useState("");
  const [name, setName] = useState("");
  const [number, setNumber] = useState("");
  const [details, setDetails] = useState("");
  const [status, setStatus] = useState("");
  const [nearby, setNearby] = useState([]);
  const [nearbyKind, setNearbyKind] = useState(null);
  const [nearbyState, setNearbyState] = useState("");
  useEffect(() => {
    if (!open) return;
    try {
      const saved = JSON.parse(
        localStorage.getItem("ys_emergency_contacts") ?? "[]",
      );
      if (Array.isArray(saved)) {
        const valid = saved
          .filter(
            (item) =>
              !!item &&
              typeof item.id === "string" &&
              typeof item.name === "string" &&
              typeof item.number === "string",
          )
          .slice(0, 3);
        setContacts(valid);
        setSelectedContact(valid[0]?.id ?? "");
      }
    } catch {
      /* Invalid local data is ignored. */
    }
    const handleKey = (event) => {
      if (event.key === "Escape") onClose();
    };
    document.addEventListener("keydown", handleKey);
    return () => document.removeEventListener("keydown", handleKey);
  }, [open, onClose]);
  function requestLocation() {
    if (!("geolocation" in navigator)) {
      setLocationState(
        "This device doesn't support browser location. You can still call 112 or share a landmark.",
      );
      return;
    }
    setLocationState("Requesting permission from your device…");
    navigator.geolocation.getCurrentPosition(
      (result) => {
        setPosition({
          lat: result.coords.latitude,
          lng: result.coords.longitude,
        });
        setLocationState(
          "Location available for the message you choose to share. Accuracy depends on your device.",
        );
      },
      () =>
        setLocationState(
          "Location unavailable or permission denied. You can still call 112 and describe a nearby landmark.",
        ),
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 },
    );
  }
  function saveContact(event) {
    event.preventDefault();
    if (contacts.length >= 3) {
      setStatus("You can save up to three contacts on this device.");
      return;
    }
    const cleaned = number.replace(/[\s()-]/g, "");
    if (!/^\+?\d{7,15}$/.test(cleaned) || !name.trim()) {
      setStatus("Enter a name and a valid phone number with country code.");
      return;
    }
    const contact = {
      id: crypto.randomUUID(),
      name: name.trim().slice(0, 40),
      number: cleaned,
    };
    const next = [...contacts, contact];
    setContacts(next);
    setSelectedContact(contact.id);
    localStorage.setItem("ys_emergency_contacts", JSON.stringify(next));
    setName("");
    setNumber("");
    setStatus("Contact saved on this device only.");
  }
  function removeContact(id) {
    const next = contacts.filter((contact) => contact.id !== id);
    setContacts(next);
    setSelectedContact(next[0]?.id ?? "");
    localStorage.setItem("ys_emergency_contacts", JSON.stringify(next));
    setStatus("Contact removed from this device.");
  }
  const message = `I need help. Time: ${new Date().toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" })}. ${position ? `My approximate location: https://www.openstreetmap.org/?mlat=${position.lat.toFixed(5)}&mlon=${position.lng.toFixed(5)}#map=16/${position.lat.toFixed(5)}/${position.lng.toFixed(5)}.` : "My location is not available; please ask me for a nearby landmark."} ${details.trim() ? `Details: ${details.trim().slice(0, 250)}.` : ""}`;
  const activeContact = contacts.find(
    (contact) => contact.id === selectedContact,
  );
  async function shareMessage() {
    try {
      if (navigator.share) {
        await navigator.share({ title: "Emergency message", text: message });
        setStatus(
          "Shared to another app. YatraSathi cannot confirm delivery; check with your contact.",
        );
      } else if (navigator.clipboard) {
        await navigator.clipboard.writeText(message);
        setStatus(
          "Message copied, not sent. Paste it into a message or tell the 112 operator.",
        );
      } else {
        setStatus(
          "Sharing isn't available here. Read the message aloud or use your phone's SMS app.",
        );
      }
    } catch {
      setStatus(
        "Sharing was cancelled or failed. No message was sent by YatraSathi.",
      );
    }
  }
  async function findNearby(kind) {
    if (!position) {
      setNearbyState(
        "Choose ‘Use my location’ first, or call 112 and describe a nearby landmark.",
      );
      return;
    }
    setNearbyKind(kind);
    setNearby([]);
    setNearbyState("Searching OpenStreetMap listings…");
    try {
      const response = await fetch(
        `/api/nearby?lat=${position.lat}&lng=${position.lng}&kind=${kind}`,
      );
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Listings unavailable.");
      setNearby(data.places ?? []);
      setNearbyState(
        data.places?.length
          ? "OpenStreetMap listings are community-edited and not emergency-verified. Confirm details before traveling."
          : "No matching map listings found nearby. Call 112 for urgent help.",
      );
    } catch (error) {
      setNearbyState(
        error instanceof Error
          ? error.message
          : "Search unavailable. Call 112 for urgent help.",
      );
    }
  }
  if (!open) return null;
  return (
    <div className="overlay sos-overlay" onMouseDown={onClose}>
      <section
        className="sos-modal"
        role="dialog"
        aria-modal="true"
        aria-label={t("sos.title")}
        onMouseDown={(event) => event.stopPropagation()}
      >
        <div className="sos-modal-head">
          <span className="sos-head-icon">
            <ShieldAlert size={22} />
          </span>
          <div>
            <span className="eyebrow small-eyebrow">HELP, WHEN IT MATTERS</span>
            <h2>{t("sos.title")}</h2>
          </div>
          <button
            className="icon-button"
            type="button"
            onClick={onClose}
            aria-label={t("common.close")}
          >
            <X size={21} />
          </button>
        </div>
        <div className="sos-modal-body">
          <div className="sos-main">
            <div className="emergency-call-card">
              <span className="eyebrow small-eyebrow">
                {t("sos.emergency")}
              </span>
              <h3>112</h3>
              <p>
                India&apos;s national emergency number. For police, fire and
                medical emergencies.
              </p>
              <a
                className="call-button"
                href="tel:112"
                onClick={() =>
                  setStatus(
                    "Phone dialer requested. You must place the call; YatraSathi cannot confirm it connected.",
                  )
                }
              >
                <Phone size={19} fill="currentColor" /> {t("sos.call")}{" "}
                <ArrowUpRight size={17} />
              </a>
              <small>{t("sos.callNote")}</small>
            </div>
            <div className="sos-step">
              <div className="sos-step-title">
                <span>01</span>
                <h4>Choose whether to use location</h4>
              </div>
              <p>
                {t("sos.consent")} It stays on this device unless you choose to
                share or search nearby listings.
              </p>
              <button
                type="button"
                className="outline-action"
                onClick={requestLocation}
              >
                <MapPin size={17} />
                {t("sos.location")}
              </button>
              {locationState && (
                <p className="inline-status" role="status">
                  {position && <Check size={15} />}
                  {locationState}
                </p>
              )}
            </div>
            <div className="sos-step">
              <div className="sos-step-title">
                <span>02</span>
                <h4>Find a nearby public service</h4>
              </div>
              <p>
                Searching sends your approximate coordinates through our server
                to OpenStreetMap&apos;s Overpass service. Listings are not
                verified by YatraSathi.
              </p>
              <div className="sos-nearby-buttons">
                <button
                  type="button"
                  className="outline-action"
                  onClick={() => void findNearby("hospital")}
                >
                  <Hospital size={17} /> Hospitals
                </button>
                <button
                  type="button"
                  className="outline-action"
                  onClick={() => void findNearby("police")}
                >
                  <ShieldAlert size={17} /> Police stations
                </button>
              </div>
              {nearbyState && (
                <p className="inline-status" role="status">
                  {nearbyState}
                </p>
              )}
              {nearbyKind && position && (
                <a
                  className="sos-external-link"
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${nearbyKind} near ${position.lat.toFixed(4)},${position.lng.toFixed(4)}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open an external map instead <ArrowUpRight size={13} />
                  <small>
                    Shares approximate location with Google when you open it.
                  </small>
                </a>
              )}
              {nearbyKind && nearby.length > 0 && (
                <div className="sos-nearby-list">
                  {nearby.slice(0, 5).map((place) => (
                    <a
                      key={place.id}
                      href={`https://www.openstreetmap.org/?mlat=${place.lat}&mlon=${place.lng}#map=17/${place.lat}/${place.lng}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {place.name}
                      <ArrowUpRight size={14} />
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
          <div className="sos-side">
            <div className="sos-side-inner">
              <span className="eyebrow small-eyebrow">YOUR PEOPLE</span>
              <h3>Prepare a message.</h3>
              <p className="sos-muted">
                Nothing is automatically sent. You choose whether to share,
                copy, or open SMS.
              </p>
              <div className="sos-contacts">
                <label className="field-label">{t("sos.contact")}</label>
                {contacts.map((contact) => (
                  <div className="contact-item" key={contact.id}>
                    <label>
                      <input
                        type="radio"
                        name="emergencyContact"
                        checked={selectedContact === contact.id}
                        onChange={() => setSelectedContact(contact.id)}
                      />{" "}
                      <span>
                        {contact.name}
                        <small>{contact.number}</small>
                      </span>
                    </label>
                    <button
                      type="button"
                      onClick={() => removeContact(contact.id)}
                      aria-label={`Remove ${contact.name}`}
                    >
                      <Trash2 size={15} />
                    </button>
                  </div>
                ))}
                {contacts.length < 3 && (
                  <form className="add-contact" onSubmit={saveContact}>
                    <input
                      aria-label="Contact name"
                      placeholder="Contact name"
                      value={name}
                      onChange={(event) => setName(event.target.value)}
                      maxLength={40}
                    />
                    <input
                      aria-label="Contact phone number"
                      placeholder={t("sos.contactPlaceholder")}
                      value={number}
                      onChange={(event) => setNumber(event.target.value)}
                      inputMode="tel"
                    />
                    <button type="submit">
                      <Plus size={15} /> Add contact
                    </button>
                  </form>
                )}
                <small className="muted-caption">{t("sos.contactNote")}</small>
              </div>
              <label className="field-label" htmlFor="sos-details">
                Optional details or a nearby landmark
              </label>
              <textarea
                id="sos-details"
                rows={2}
                maxLength={250}
                value={details}
                onChange={(event) => setDetails(event.target.value)}
                placeholder="I'm near the main entrance…"
              />
              <label className="field-label">{t("sos.message")}</label>
              <div className="prepared-message">{message}</div>
              <button
                className="share-button"
                type="button"
                onClick={() => void shareMessage()}
              >
                <Send size={16} />
                {t("sos.share")} <Copy size={15} />
              </button>
              {activeContact && (
                <a
