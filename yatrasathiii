  const [sosOpen, setSosOpen] = useState(false);
  const [assistantRequest, setAssistantRequest] = useState({ key: 0 });
  const language = useSyncExternalStore(
    subscribeToLanguage,
    readLanguagePreference,
    () => "en",
  );

  useEffect(() => {
    document.documentElement.lang = language;
    void i18n.changeLanguage(language);
  }, [language]);

  const changeLanguage = (value) => {
    sessionLanguage = value;
    try {
      localStorage.setItem("ys_language", value);
    } catch {
      // The in-memory value still lets the selector work for this session.
    }
    window.dispatchEvent(new Event("yatrasathi:language"));
  };
  const openAssistant = useCallback((prompt, destination) => {
    setAssistantRequest((previous) => ({
      prompt,
      destination,
      key: previous.key + 1,
    }));
    setAssistantOpen(true);
    setMenuOpenedOnPath(null);
  }, []);
  const openSos = useCallback(() => {
    setSosOpen(true);
    setMenuOpenedOnPath(null);
