export const dynamic = "force-dynamic";
const kinds = ["hospital", "police", "pharmacy", "restaurant", "hotel"];
const cache = new Map();
export async function GET(request) {
  const params = request.nextUrl.searchParams;
  const lat = Number(params.get("lat"));
  const lng = Number(params.get("lng"));
  const kind = params.get("kind");
  if (
    !Number.isFinite(lat) ||
    !Number.isFinite(lng) ||
    lat < 6 ||
    lat > 38 ||
    lng < 68 ||
    lng > 98 ||
    !kinds.includes(kind)
  ) {
    return Response.json(
      { error: "Choose a valid location and place type in India." },
      { status: 400 },
    );
  }
  const key = `${lat.toFixed(2)}:${lng.toFixed(2)}:${kind}`;
  const existing = cache.get(key);
  if (existing && Date.now() - existing.time < 10 * 60 * 1000) {
    return Response.json({
      places: existing.places,
      source: "OpenStreetMap via Overpass",
      cached: true,
    });
  }
  const tag = kind === "hotel" ? "tourism" : "amenity";
  const radius = kind === "restaurant" ? 2000 : 4500;
  const query = `[out:json][timeout:12];nwr["${tag}"="${kind}"]["name"](around:${radius},${lat.toFixed(5)},${lng.toFixed(5)});out center 35;`;
  try {
    const response = await fetch("https://overpass-api.de/api/interpreter", {
      method: "POST",
      headers: {
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "YatraSathi-hackathon-prototype/1.0",
      },
      body: new URLSearchParams({ data: query }),
      signal: AbortSignal.timeout(11000),
      cache: "no-store",
    });
    if (!response.ok) throw new Error("Overpass unavailable");
    const data = await response.json();
    const places = (data.elements ?? [])
      .map((item) => ({
        id: `${item.type}-${item.id}`,
        name: item.tags?.name ?? "Unnamed place",
        kind,
        lat: item.lat ?? item.center?.lat ?? NaN,
        lng: item.lon ?? item.center?.lon ?? NaN,
        address:
          [item.tags?.["addr:street"], item.tags?.["addr:city"]]
            .filter(Boolean)
            .join(", ") || undefined,
      }))
      .filter((item) => Number.isFinite(item.lat) && Number.isFinite(item.lng))
      .slice(0, 35);
    if (cache.size > 200) cache.clear();
    cache.set(key, { time: Date.now(), places });
    return Response.json({
      places,
      source: "OpenStreetMap via Overpass",
      cached: false,
    });
  } catch {
    return Response.json(
      {
        error:
          "Live map listings are unavailable right now. Try an external map or call 112 in an emergency.",
      },
      { status: 503 },
    );
  }
}
