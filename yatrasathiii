function readFavoritesSnapshot() {
  try {
    return localStorage.getItem("ys_favorites") ?? "[]";
  } catch {
    return "[]";
  }
}

function subscribeToFavorites(callback) {
  window.addEventListener("storage", callback);
  window.addEventListener("yatrasathi:favorites", callback);
  return () => {
    window.removeEventListener("storage", callback);
    window.removeEventListener("yatrasathi:favorites", callback);
  };
}

