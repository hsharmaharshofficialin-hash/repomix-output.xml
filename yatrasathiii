export function ChatDrawer({ open, onClose, initialPrompt, destination }) {
  const { t, i18n } = useTranslation();
  const [messages, setMessages] = useState([
    { role: "assistant", content: t("assistant.intro") },
  ]);
  const [input, setInput] = useState(initialPrompt ?? "");
  const [busy, setBusy] = useState(false);
  const [mode, setMode] = useState("checking");
  const [error, setError] = useState("");
  const [speechAvailable, setSpeechAvailable] = useState(false);
  const inputRef = useRef(null);
  const bottomRef = useRef(null);
  useEffect(() => {
    if (!open) return;
    inputRef.current?.focus();
    setSpeechAvailable(
      typeof window !== "undefined" &&
        !!(window.SpeechRecognition || window.webkitSpeechRecognition),
    );
    const closeOnEscape = (event) => {
      if (event.key === "Escape") onClose();
    };
    document.addEventListener("keydown", closeOnEscape);
    fetch("/api/chat")
      .then((response) => {
        if (!response.ok) throw new Error("Mode check failed");
        return response.json();
      })
      .then((data) => setMode(data.mode === "live" ? "live" : "demo"))
      .catch(() => setMode("unknown"));
    return () => document.removeEventListener("keydown", closeOnEscape);
  }, [open, onClose]);
  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth", block: "end" });
  }, [messages, busy]);
  async function sendMessage(text) {
    const trimmed = text.trim();
    if (!trimmed || busy) return;
    const next = [...messages, { role: "user", content: trimmed }];
    setMessages(next);
    setInput("");
    setBusy(true);
    setError("");
    try {
      const response = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          messages: next
            .slice(-10)
            .map(({ role, content }) => ({ role, content })),
          destination,
          language: i18n.language === "hi" ? "hi" : "en",
        }),
      });
      const data = await response.json();
      if (!response.ok || !data.reply)
        throw new Error(data.error || t("assistant.error"));
      setMode(data.mode === "live" ? "live" : "demo");
      setMessages((current) => [
        ...current,
        { role: "assistant", content: data.reply, note: data.note },
      ]);
    } catch (cause) {
      setError(cause instanceof Error ? cause.message : t("assistant.error"));
    } finally {
      setBusy(false);
      inputRef.current?.focus();
    }
  }
  function handleSubmit(event) {
    event.preventDefault();
    void sendMessage(input);
  }
  function speak(text) {
    if (!("speechSynthesis" in window)) {
      setError("Speech playback is not supported by this browser.");
      return;
    }
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = i18n.language === "hi" ? "hi-IN" : "en-IN";
    utterance.rate = 0.94;
    window.speechSynthesis.speak(utterance);
  }
  function listen() {
    const browser = window;
    const Recognition =
      browser.SpeechRecognition || browser.webkitSpeechRecognition;
    if (!Recognition) return;
    const recognition = new Recognition();
    recognition.lang = i18n.language === "hi" ? "hi-IN" : "en-IN";
    recognition.onresult = (event) =>
      setInput(event.results[0]?.[0]?.transcript ?? "");
    recognition.onerror = () =>
      setError("Voice input didn't work. You can type instead.");
    try {
      recognition.start();
    } catch {
      setError("Microphone couldn't start. You can type instead.");
    }
