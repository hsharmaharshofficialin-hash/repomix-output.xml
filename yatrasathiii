            <Link className="footer-cta" href="/plan">
              Start planning <ArrowUpRight size={18} />
            </Link>
          </div>
          <div className="footer-link-groups">
            <div>
              <h3>{t("footer.explore")}</h3>
              <Link href="/#discover">Destinations</Link>
              <Link href="/#stories">Stories behind the stones</Link>
              <Link href="/map">Interactive map</Link>
