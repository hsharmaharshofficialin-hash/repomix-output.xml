import {
  boolean,
  index,
  jsonb,
  pgTable,
  timestamp,
  uuid,
  varchar,
} from "drizzle-orm/pg-core";

// Each plan belongs to a random guest cookie, not a signed-in account.
// JSONB stores the selected destinations and the editable day-by-day itinerary.
export const tripPlans = pgTable(
  "trip_plans",
  {
    id: uuid("id").primaryKey().defaultRandom(),
    visitorId: varchar("visitor_id", { length: 72 }).notNull(),
    title: varchar("title", { length: 160 }).notNull(),
    destinations: jsonb("destinations").notNull(),
    startDate: varchar("start_date", { length: 10 }).notNull(),
    endDate: varchar("end_date", { length: 10 }).notNull(),
    budget: varchar("budget", { length: 32 }).notNull(),
    accommodation: varchar("accommodation", { length: 32 })
      .notNull()
      .default("flexible"),
    transport: varchar("transport", { length: 32 })
      .notNull()
      .default("flexible"),
    language: varchar("language", { length: 8 }).notNull().default("en"),
    interests: jsonb("interests").notNull(),
    stepFreeNeeded: boolean("step_free_needed").notNull().default(false),
    itinerary: jsonb("itinerary").notNull(),
    createdAt: timestamp("created_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
  },
  (table) => [index("trip_plans_visitor_idx").on(table.visitorId)],
);
