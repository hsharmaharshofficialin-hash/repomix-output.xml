          <div>
            <span className="eyebrow section-eyebrow">
              <span className="section-number">✳</span>THE FIELD MAP
            </span>
            <h1>
              Find your <em>bearings.</em>
            </h1>
            <p>
              Get to know a place before you arrive. Landmarks are curated;
              nearby services come from community-edited OpenStreetMap data and
              are not verified by YatraSathi.
            </p>
          </div>
          <div className="map-page-compass">
            <Compass size={58} strokeWidth={0.9} />
          </div>
        </div>
      </div>
      <div className="container full-map-layout">
        <aside className="full-map-sidebar">
          <span className="eyebrow small-eyebrow">CHOOSE YOUR CITY</span>
          <div className="map-city-list">
            {destinations.map((place, index) => (
              <button
                className={slug === place.slug ? "active" : ""}
                key={place.slug}
                type="button"
                onClick={() => setSlug(place.slug)}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{place.name}</strong>
                <ArrowUpRight size={17} />
              </button>
            ))}
          </div>
          <div className="map-sidebar-info">
            <span>YOUR MAP NOTES</span>
            <h2>{destination.shortLabel}</h2>
            <p>{destination.introduction}</p>
            <Link href={`/destinations/${destination.slug}`}>
              Discover {destination.name} <ArrowRight size={15} />
            </Link>
          </div>
        </aside>
        <div className="full-map-main">
          <MapExplorer key={destination.slug} destination={destination} />
          <div className="full-map-under">
            <div>
              <TrainFront size={18} />
              <p>
                <strong>Transport, without guesswork.</strong> Stations here are
                location references only. Live services, fares, routes and
                accessibility details are not connected.
              </p>
            </div>
            <button
              type="button"
              onClick={() =>
                openAssistant(
                  `How should I get around ${destination.name}?`,
                  destination.slug,
                )
