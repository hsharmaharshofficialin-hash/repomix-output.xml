import { cookies } from "next/headers";
import { and, eq } from "drizzle-orm";
import { db } from "@/db";
import { tripPlans } from "@/db/schema";
import { validateItinerary } from "@/lib/planner";
import { isSameOrigin } from "@/lib/request-security";
import {
  guestCookieName,
  isValidGuestId,
  publicTrip,
} from "@/lib/trip-security";

export const dynamic = "force-dynamic";
const tripIdPattern =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

async function ownerFor(request, context) {
  const { id } = await context.params;
  const visitorId = (await cookies()).get(guestCookieName)?.value;
  if (
    !tripIdPattern.test(id) ||
    !isValidGuestId(visitorId) ||
    !isSameOrigin(request)
  )
    return null;
  return { id, visitorId };
}

// PATCH /api/trips/:id: an editable itinerary, owned by this guest cookie.
export async function PATCH(request, context) {
  const owner = await ownerFor(request, context);
  if (!owner)
    return Response.json({ error: "Trip not found." }, { status: 404 });

  try {
    const raw = await request.text();
    if (raw.length > 22000)
      return Response.json({ error: "Plan is too large." }, { status: 413 });
    const body = JSON.parse(raw);
    if (!body || !validateItinerary(body.itinerary)) {
      return Response.json({ error: "Invalid itinerary." }, { status: 400 });
    }

    const [trip] = await db
      .update(tripPlans)
      .set({ itinerary: body.itinerary })
      .where(
        and(
          eq(tripPlans.id, owner.id),
          eq(tripPlans.visitorId, owner.visitorId),
        ),
      )
      .returning();
    if (!trip)
      return Response.json({ error: "Trip not found." }, { status: 404 });
    return Response.json(
      { trip: publicTrip(trip) },
      {
        headers: { "Cache-Control": "private, no-store" },
      },
    );
  } catch (error) {
    if (error instanceof SyntaxError)
      return Response.json({ error: "Invalid JSON." }, { status: 400 });
    return Response.json(
      { error: "Couldn't update this trip." },
      { status: 503 },
    );
  }
}

// DELETE /api/trips/:id: include the guest ID in the WHERE clause.
export async function DELETE(request, context) {
  const owner = await ownerFor(request, context);
  if (!owner)
    return Response.json({ error: "Trip not found." }, { status: 404 });

  try {
    const [trip] = await db
      .delete(tripPlans)
      .where(
        and(
          eq(tripPlans.id, owner.id),
          eq(tripPlans.visitorId, owner.visitorId),
        ),
      )
      .returning({ id: tripPlans.id });
    if (!trip)
      return Response.json({ error: "Trip not found." }, { status: 404 });
    return Response.json({ deleted: true });
  } catch {
    return Response.json(
      { error: "Couldn't delete this trip." },
      { status: 503 },
    );
  }
}
