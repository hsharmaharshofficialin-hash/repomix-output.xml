    Array.isArray(input.destinations) &&
    input.destinations.length > 0 &&
    input.destinations.length <= 6 &&
    input.destinations.every(
      (slug) => typeof slug === "string" && !!getDestination(slug),
    ) &&
    typeof input.startDate === "string" &&
    typeof input.endDate === "string" &&
    dateRange(input.startDate, input.endDate).length > 0 &&
    dateRange(input.startDate, input.endDate).length <= 7 &&
    typeof input.budget === "string" &&
    ["mindful", "balanced", "flexible"].includes(input.budget) &&
    typeof input.accommodation === "string" &&
    ["flexible", "budget", "comfort"].includes(input.accommodation) &&
    typeof input.transport === "string" &&
    ["flexible", "public", "walking", "taxi"].includes(input.transport) &&
    typeof input.language === "string" &&
    ["en", "hi"].includes(input.language) &&
    Array.isArray(input.interests) &&
    input.interests.length <= 8 &&
