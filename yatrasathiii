class OpenAIProvider {
  apiKey;
  constructor(apiKey) {
    this.apiKey = apiKey;
  }
  async respond(request) {
    const place = selectedDestination(request);
    const context = place
      ? `Selected destination: ${place.name}, ${place.state}. Curated reference: ${place.storyLead} ${place.story} Local etiquette: ${place.etiquette.join(" ")} Source links: ${place.sources.map((source) => `${source.name}: ${source.url}`).join("; ")}.`
      : "No destination selected. Ask for a city if needed.";
    const instructions = `You are Sathi, a thoughtful travel companion for India. Respond in ${request.language === "hi" ? "Hindi" : "English"}. Be concise, warm, and practical. Distinguish documented facts, suggestions, and uncertainty. Cite the supplied source URL when stating a historical fact. Do not invent live opening hours, fares, routes, events, available guides, verification statuses, accessibility guarantees, or safety guarantees. You have no live transport, booking, weather or emergency dispatch tools. For immediate danger in India, advise calling 112; never claim an alert was sent. For translation, give the translation and note that nuance should be checked. Ask one useful follow-up when details are missing. ${context}`;
    const response = await fetch("https://api.openai.com/v1/responses", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${this.apiKey}`,
      },
      body: JSON.stringify({
        model: process.env.OPENAI_MODEL || "gpt-4.1-mini",
        instructions,
        input: request.messages.map((message) => ({
          role: message.role,
          content: message.content,
        })),
        max_output_tokens: 600,
        store: false,
      }),
      signal: AbortSignal.timeout(25000),
      cache: "no-store",
    });
    if (!response.ok)
      throw new Error(`AI provider responded ${response.status}`);
    const data = await response.json();
    const reply = data.output
      ?.flatMap((item) => item.content ?? [])
      .filter((part) => part.type === "output_text")
      .map((part) => part.text ?? "")
      .join("\n")
      .trim();
    if (!reply) throw new Error("AI provider returned no text");
    return {
      reply,
      mode: "live",
      note: "AI-generated answer. Verify important travel and safety details with official sources.",
    };
  }
}
export function getAIProvider() {
  const key = process.env.OPENAI_API_KEY;
  return key ? new OpenAIProvider(key) : new DemoProvider();
}
export function aiMode() {
  return process.env.OPENAI_API_KEY ? "live" : "demo";
