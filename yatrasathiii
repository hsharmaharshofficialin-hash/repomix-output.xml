              Ask Sathi <ArrowUpRight size={16} />
            </button>
          </div>
        </div>
      </div>
      <div className="container full-map-resources">
        <div>
          <span className="eyebrow small-eyebrow">IN CASE YOU NEED HELP</span>
          <h2>
            A map is a starting point,
            <br />
            <em>not a safety guarantee.</em>
          </h2>
        </div>
        <div>
          <p>
