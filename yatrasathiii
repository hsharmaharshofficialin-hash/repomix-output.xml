export function buildSampleItinerary(input) {
  const periods = ["Morning", "Midday", "Later in the day"];
  const transportAdvice = {
    public:
      "Check an official local transit source for current routes and departures.",
    walking:
      "Check walking distances and pavement conditions before setting out.",
    taxi: "Confirm pick-up, meter or quoted fare with a licensed provider before travel.",
    flexible: "Choose transport after checking current local options.",
  };
  return dateRange(input.startDate, input.endDate).map((day, index) => {
    const destination = getDestination(
      input.destinations[index % input.destinations.length],
    );
    return {
      date: day.toISOString().slice(0, 10),
      destination: destination.name,
      stops: destination.dayIdeas.map((idea, i) => ({
        period: periods[i],
        title: idea.title,
        detail: [
          idea.detail,
          i === 0 ? transportAdvice[input.transport] : "",
          i === 1 && input.stepFreeNeeded
            ? "Confirm step-free entry and a suitable route with the venue directly."
            : "",
          i === 2 && input.budget === "mindful"
            ? "Check official admission charges and free public alternatives before you go."
            : "",
          i === 2 && input.interests.length
            ? `Leave room for your interest in ${input.interests[0].toLowerCase()}.`
            : "",
          i === 2 && input.accommodation !== "flexible"
            ? `Compare current ${input.accommodation === "budget" ? "budget" : "comfort-focused"} stays near your preferred area before booking.`
            : "",
        ]
          .filter(Boolean)
          .join(" "),
      })),
    };
  });
}
export function validateItinerary(value) {
  return (
    Array.isArray(value) &&
    value.length > 0 &&
    value.length <= 7 &&
    value.every((day) => {
      if (!day || typeof day !== "object") return false;
      const item = day;
      return (
        typeof item.date === "string" &&
        datePattern.test(item.date) &&
        typeof item.destination === "string" &&
        item.destination.length <= 80 &&
        Array.isArray(item.stops) &&
        item.stops.length <= 8 &&
        item.stops.every((stop) => {
          if (!stop || typeof stop !== "object") return false;
          const entry = stop;
          return [entry.period, entry.title, entry.detail].every(
            (field) => typeof field === "string" && field.length <= 500,
          );
        })
      );
    })
  );
