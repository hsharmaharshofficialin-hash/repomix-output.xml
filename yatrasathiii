let sessionLanguage = "en";
function readLanguagePreference() {
  try {
    return localStorage.getItem("ys_language") === "hi" ? "hi" : "en";
  } catch {
    return sessionLanguage;
  }
}

function subscribeToLanguage(callback) {
  window.addEventListener("storage", callback);
  window.addEventListener("yatrasathi:language", callback);
  return () => {
    window.removeEventListener("storage", callback);
    window.removeEventListener("yatrasathi:language", callback);
  };
}

const ExperienceContext = createContext(null);
export function useExperience() {
  const actions = useContext(ExperienceContext);
  if (!actions) throw new Error("useExperience must be inside SiteShell");
  return actions;
}
function Brand({ light = false }) {
  return (
    <Link
      href="/"
      className={`brand ${light ? "brand-light" : ""}`}
      aria-label="YatraSathi home"
