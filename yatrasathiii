import { randomUUID } from "node:crypto";
import { cookies } from "next/headers";
import { desc, eq } from "drizzle-orm";
import { db } from "@/db";
import { tripPlans } from "@/db/schema";
import { getDestination } from "@/lib/destinations";
import {
  buildSampleItinerary,
  validateItinerary,
  validatePlanInput,
} from "@/lib/planner";
import { isSameOrigin } from "@/lib/request-security";
import {
  guestCookieName,
  isValidGuestId,
  publicTrip,
} from "@/lib/trip-security";

export const dynamic = "force-dynamic";

// GET /api/trips: only plans belonging to this browser's guest cookie.
export async function GET() {
  const visitorId = (await cookies()).get(guestCookieName)?.value;
  if (!isValidGuestId(visitorId)) return Response.json({ trips: [] });

  try {
    const trips = await db
      .select()
      .from(tripPlans)
      .where(eq(tripPlans.visitorId, visitorId))
      .orderBy(desc(tripPlans.createdAt))
      .limit(25);
    return Response.json(
      { trips: trips.map(publicTrip) },
      {
        headers: { "Cache-Control": "private, no-store" },
      },
    );
  } catch {
    return Response.json(
      { error: "Saved trips are temporarily unavailable." },
      { status: 503 },
    );
  }
}

// POST /api/trips: validate the visitor's input before writing to PostgreSQL.
export async function POST(request) {
  if (!isSameOrigin(request)) {
    return Response.json({ error: "Invalid origin." }, { status: 403 });
  }

  try {
    const raw = await request.text();
    if (raw.length > 25000)
      return Response.json({ error: "Plan is too large." }, { status: 413 });

    const body = JSON.parse(raw);
    if (!body || !validatePlanInput(body.plan)) {
      return Response.json(
        { error: "Check your destinations, dates, and preferences." },
        { status: 400 },
      );
    }
    if (body.itinerary !== undefined && !validateItinerary(body.itinerary)) {
      return Response.json(
        { error: "The edited itinerary is not valid." },
        { status: 400 },
      );
    }

    const plan = body.plan;
    const cookieStore = await cookies();
    const previousId = cookieStore.get(guestCookieName)?.value;
    const visitorId = isValidGuestId(previousId) ? previousId : randomUUID();

    // A small limit keeps this unauthenticated prototype from storing unlimited plans.
    const existing = await db
      .select({ id: tripPlans.id })
      .from(tripPlans)
      .where(eq(tripPlans.visitorId, visitorId))
      .limit(25);
    if (existing.length >= 25) {
      return Response.json(
        {
          error: "This guest space is full. Delete a saved plan to make room.",
        },
        { status: 429 },
      );
    }

    const names = plan.destinations.map((slug) => getDestination(slug).name);
    const [trip] = await db
      .insert(tripPlans)
      .values({
        visitorId,
        title: `${names.join(" + ")} journey`,
        destinations: plan.destinations,
        startDate: plan.startDate,
        endDate: plan.endDate,
        budget: plan.budget,
        accommodation: plan.accommodation,
        transport: plan.transport,
        language: plan.language,
        interests: plan.interests,
        stepFreeNeeded: plan.stepFreeNeeded,
        itinerary:
          body.itinerary === undefined
            ? buildSampleItinerary(plan)
            : body.itinerary,
      })
      .returning();

    const response = Response.json(
      { trip: publicTrip(trip) },
      {
        status: 201,
        headers: { "Cache-Control": "private, no-store" },
      },
    );
    if (!isValidGuestId(previousId)) {
      response.headers.append(
        "Set-Cookie",
        `${guestCookieName}=${visitorId}; Path=/; HttpOnly; SameSite=Lax; Max-Age=31536000${process.env.NODE_ENV === "production" ? "; Secure" : ""}`,
      );
    }
    return response;
  } catch (error) {
    if (error instanceof SyntaxError)
      return Response.json({ error: "Invalid JSON." }, { status: 400 });
    return Response.json(
      { error: "Couldn't save this trip right now. Please try again." },
      { status: 503 },
    );
  }
}
